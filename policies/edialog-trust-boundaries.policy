DOCUMENT EDIALOG_TRUST_BOUNDARIES
VERSION 1
LANGUAGE PL
MODE STRICT
PURPOSE "Reguły doboru strategii emocjonalnych i poszanowania granic osobistych w zależności od poziomu zaufania między aktorami dialogu"
POLICY "edialog.trust/policy/v1"

TRUST_ZERO = "zero"
TRUST_LOW = "low"
TRUST_HIGH = "high"
TRUST_REBUILDING = "rebuilding"
KNOWN_TRUST_LEVELS = [TRUST_ZERO, TRUST_LOW, TRUST_HIGH, TRUST_REBUILDING]
CAUTIOUS_TRUST_LEVELS = [TRUST_ZERO, TRUST_LOW]

ASSERT TRUST_ZERO IN KNOWN_TRUST_LEVELS
ASSERT TRUST_LOW IN CAUTIOUS_TRUST_LEVELS

TEMPLATE ENFORCE_BOUNDARY_RESPECT
DO RECORD BOUNDARY_MODE "NON_INTRUSIVE"
DO RECORD ALLOW_IMPERATIVE_COMMANDS FALSE
DO RECORD ALLOW_THRILLER_SCARED_TARGET FALSE
END

RULE TRUST-CAUTIOUS-BOUNDARY TYPE REQUIRED
WHEN TRUST_LEVEL IN CAUTIOUS_TRUST_LEVELS
DO APPLY_TEMPLATE ENFORCE_BOUNDARY_RESPECT
DO RECORD RECOMMENDED_STRATEGIES "quiet,anticipation"
DO ALLOW GENERATE_OBSERVATIONAL_TURN
FORBID ISSUE_PHYSICAL_MOVEMENT_COMMAND
FORBID FORCE_INTIMATE_CONFESSION

RULE TRUST-HIGH-INTIMACY TYPE REQUIRED
WHEN TRUST_LEVEL = TRUST_HIGH
DO RECORD BOUNDARY_MODE "WARM_CONSENSUAL"
DO RECORD RECOMMENDED_STRATEGIES "reunion,anticipation,quiet"
DO ALLOW REFERENCE_SHARED_HISTORY
DO ALLOW GENERATE_AFFECTIONATE_TURN

RULE TRUST-REBUILDING-CALM TYPE REQUIRED
WHEN TRUST_LEVEL = TRUST_REBUILDING
DO APPLY_TEMPLATE ENFORCE_BOUNDARY_RESPECT
DO RECORD RECOMMENDED_STRATEGIES "quiet,release"
DO ALLOW ACKNOWLEDGE_PAST_DISTANCE
FORBID DEMAND_IMMEDIATE_FORGIVENESS
