{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Affect Fiction 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "version",
    "mode",
    "actor",
    "recipients",
    "request",
    "history_fingerprint",
    "context_turn_ids",
    "model",
    "image",
    "candidate_pool",
    "candidate_origin"
  ],
  "properties": {
    "language": {
      "const": "affect-fiction"
    },
    "version": {
      "const": "0.3"
    },
    "mode": {
      "const": "fiction"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "strategies",
        "tolerance"
      ],
      "properties": {
        "target": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "scared",
              "sad",
              "angry",
              "nothing",
              "happy",
              "h-cited",
              "excited"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "strategies": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "suspense",
              "loss",
              "confrontation",
              "reunion",
              "celebration",
              "anticipation",
              "quiet",
              "release"
            ]
          }
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "history_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_turn_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzer",
        "retention",
        "image_weight",
        "scoring_version"
      ],
      "properties": {
        "analyzer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lexicon",
            "context_window",
            "context_decay"
          ],
          "properties": {
            "lexicon": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "provenance",
                "entries",
                "context_rules"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "entries": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 10000,
                  "additionalProperties": {
                    "type": "object",
                    "propertyNames": {
                      "enum": [
                        "scared",
                        "sad",
                        "angry",
                        "nothing",
                        "happy",
                        "h-cited",
                        "excited"
                      ]
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "context_rules": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "phrase",
                      "requires",
                      "threshold",
                      "weights"
                    ],
                    "properties": {
                      "phrase": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requires": {
                        "enum": [
                          "scared",
                          "sad",
                          "angry",
                          "nothing",
                          "happy",
                          "h-cited",
                          "excited"
                        ]
                      },
                      "threshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "weights": {
                        "type": "object",
                        "propertyNames": {
                          "enum": [
                            "scared",
                            "sad",
                            "angry",
                            "nothing",
                            "happy",
                            "h-cited",
                            "excited"
                          ]
                        },
                        "additionalProperties": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            "context_window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "context_decay": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "retention": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "image_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scoring_version": {
          "const": "fiction-tone-v1"
        }
      }
    },
    "image": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image_sha256",
            "features",
            "scores",
            "evidence",
            "caption",
            "origin",
            "warnings"
          ],
          "properties": {
            "image_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "features": {
              "type": "object"
            },
            "scores": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "scared",
                  "sad",
                  "angry",
                  "nothing",
                  "happy",
                  "h-cited",
                  "excited"
                ]
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "evidence": {
              "type": "array"
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "candidate_pool": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_turn_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "evidence_turn_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "candidate_origin": {
      "type": "string",
      "minLength": 1
    }
  }
}
